{
  "expo": {
    "name": "Counters",
    "slug": "Counters",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/counters.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.counters.mlbb",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/counters.png",
        "backgroundColor": "#000000"
      },
      "package": "app.counters.mlbb"
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/counters-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "imageWidth": 200
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "a1eb517c-8adc-4344-8fe9-182a4790dd27"
      }
    }
  }
}
